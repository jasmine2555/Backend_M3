{
  "name": "event-registration-api",
  "version": "1.0.0",
  "description": "Event Registration API with Joi validation, Firestore, OpenAPI docs, and security middleware (Helmet and CORS)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn src/server.ts",
    "test": "jest --verbose",
    "lint": "eslint -c eslint.config.mjs \"**/*.{ts,tsx}\"",
    "generate:openapi": "ts-node scripts/generateOpenApiSpec.ts"
  },
  "keywords": ["express", "typescript", "joi", "firestore", "events"],
  "author": "Jasmine Kaur",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.3",
    "@types/node": "^20.17.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
